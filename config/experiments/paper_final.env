# Canonical experiment configuration for the manuscript.
# Source this file from the repository root before running the commands in
# documents/EXPERIMENTS_FINAL.md.

RESULTS_ROOT="${RESULTS_ROOT:-results}"
OPENCLIP_CHECKPOINT="${OPENCLIP_CHECKPOINT:-checkpoints/open_clip_pytorch_model.bin}"

LERF_DATASET_ROOT="${LERF_DATASET_ROOT:-dataset/lerf}"
LERF_SCENES="${LERF_SCENES:-ramen figurines teatime}"
LERF_SEEDS="${LERF_SEEDS:-0 1 2}"
LERF_VARIANT="${LERF_VARIANT:-strict_trainview_consistency}"
LERF_MAIN_ROOT="${LERF_MAIN_ROOT:-$RESULTS_ROOT/lerf_mask/main}"
LERF_BASELINE_ROOT="${LERF_BASELINE_ROOT:-$RESULTS_ROOT/lerf_mask/baseline}"
LERF_ABLATION_ROOT="${LERF_ABLATION_ROOT:-$RESULTS_ROOT/lerf_mask/ablation}"

OVS_DATASET_ROOT="${OVS_DATASET_ROOT:-dataset/3dovs}"
OVS_SCENES="${OVS_SCENES:-bed bench blue_sofa covered_desk lawn office_desk room snacks sofa table}"
OVS_SEEDS="${OVS_SEEDS:-0 1 2}"
OVS_VARIANT="${OVS_VARIANT:-strict_trainview_consistency}"
OVS_MAIN_ROOT="${OVS_MAIN_ROOT:-$RESULTS_ROOT/3dovs/main}"
OVS_BASELINE_ROOT="${OVS_BASELINE_ROOT:-$RESULTS_ROOT/3dovs/baseline}"
OVS_CLEANUP_CONF_ROOT="${OVS_CLEANUP_CONF_ROOT:-$RESULTS_ROOT/3dovs/cleanup_conf}"

IPR_THRESHOLD=0.75
THRESHOLD_VALUES="0.65 0.70 0.75 0.80 0.85"
THRESHOLD_ROOT="${THRESHOLD_ROOT:-$RESULTS_ROOT/threshold_sensitivity}"

LERF_OVS_REPORT_ROOT="${LERF_OVS_REPORT_ROOT:-$RESULTS_ROOT/lerf_ovs}"
WALDO_MODEL_ROOT="${WALDO_MODEL_ROOT:-$RESULTS_ROOT/waldo_kitchen}"

